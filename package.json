{
  "name": "faa-det-gjort",
  "private": true,
  "version": "0.9.1",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22 <25"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:quality": "playwright test tests/e2e/phase9.spec.ts",
    "verify": "pnpm test && pnpm build && pnpm test:e2e",
    "release:check": "pnpm build && node scripts/release-check.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write src tests *.ts *.json *.md"
  },
  "dependencies": {
    "dexie": "^4.2.0",
    "dexie-react-hooks": "^4.2.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "fake-indexeddb": "^6.2.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.2",
    "vite": "^6.3.0",
    "vitest": "^3.2.0"
  }
}
